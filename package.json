{
  "name": "deepseek-web-router",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local OpenAI Responses and Chat Completions adapter for a personal DeepSeek web session (chat.deepseek.com)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/src/main.js",
    "codex:ds": "node bin/codex_ds.mjs",
    "test": "node --import tsx --test \"tests/*.test.mjs\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
