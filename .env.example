# deepseek-web-router — local configuration
# Copy this file to .env and fill in your own values.
# NEVER commit .env, never paste its contents into an issue or chat.

# --- Authentication (required) ----------------------------------------------
# Bearer token that chat.deepseek.com sends to its own API.
# DevTools -> Network -> any request to chat.deepseek.com -> request header
#   authorization: Bearer hvlt/...
# Paste everything after "Bearer ".
DEEPSEEK_BEARER_TOKEN=

# The full raw Cookie header from the same browser session, e.g.
#   .thumbcache_xxxxxxxx=...; ds_session_id=...; aws-waf-token=...
# Copy the whole header value (one line).
DEEPSEEK_COOKIE=

# Legacy alternative: the bare `userToken` cookie value (JWT) instead of the
# bearer token. Set only one of DEEPSEEK_BEARER_TOKEN / DEEPSEEK_USER_TOKEN.
# DEEPSEEK_USER_TOKEN=

# --- Local access control ----------------------------------------------------
# Every client must send: Authorization: Bearer <ROUTER_API_KEY>
# Leave empty only if every local process on the machine is trusted.
ROUTER_API_KEY=replace-with-a-long-random-value

# --- Server ------------------------------------------------------------------
HOST=127.0.0.1
PORT=20129
REQUEST_TIMEOUT_MS=120000
MAX_BODY_BYTES=2097152

# Model ids exposed by GET /v1/models. "deepseek-web-thinking" upgrades plain
# requests to thinking mode when DEEPSEEK_THINKING_ENABLED is true.
DEEPSEEK_MODELS=deepseek-web,deepseek-web-thinking

# --- Behaviour ---------------------------------------------------------------
# Request thinking mode from the web UI for the thinking model.
DEEPSEEK_THINKING_ENABLED=true
# Upgrade plain "deepseek-web" requests to thinking as well.
DEEPSEEK_THINKING_DEFAULT=true
# Enable DeepSeek web search ("false" disables it).
DEEPSEEK_SEARCH=true

# Upstream pacing and retry policy (milliseconds).
# DEEPSEEK_MIN_INTERVAL_MS=20000
# DEEPSEEK_RATE_RETRIES=5
# DEEPSEEK_BACKOFF_MS=60000

# --- Multi-account rotation (optional) ---------------------------------------
# Semicolon-separated entries: id:bearerToken:cookie
# DEEPSEEK_ACCOUNTS=acc1:hvlt/AAAA...:.thumbcache_...=...; acc2:hvlt/BBBB...:...

# --- Safety ------------------------------------------------------------------
# Refuse to bind to anything other than loopback unless this is "true".
# ALLOW_NON_LOOPBACK=false
